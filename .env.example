# Environment variables for the API Lambda.
#
# When you deploy with AWS CDK these are set automatically from the values in
# infra/cdk.json (see the README "Configuration" table). This file documents
# what each variable does and is useful for running the Lambda locally.

# Email domain whose users get read access automatically (and edit by default).
# Required. Example: example.com
ALLOWED_EMAIL_DOMAIN=

# Email address seeded as the first admin on first run. Required.
# This person manages all other editors/admins from the Admin page.
INITIAL_ADMIN_EMAIL=

# SAML/social identity provider name as configured on the Cognito user pool.
# Optional, defaults to GoogleWorkspace.
IDENTITY_PROVIDER_NAME=GoogleWorkspace

# Display name shown in the UI and notifications. Optional.
APP_NAME=RoPA Register

# Base URL of the deployed app, used to build links in Slack notifications.
# Set automatically by CDK to the CloudFront URL.
APP_BASE_URL=

# DynamoDB table name. Set automatically by CDK.
ACTIVITIES_TABLE=

# Optional Slack integration — only set these if you want Slack notifications.
# Names of AWS Secrets Manager secrets holding the webhook URL / bot token.
SLACK_WEBHOOK_SECRET_NAME=
SLACK_BOT_TOKEN_SECRET_NAME=
